<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The very same file the browser tests compile with Fable. -->
    <Compile Include="..\..\test\Shared\SharedViews.fs" Link="SharedViews.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lit.Server\Lit.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- For the page template. Lit.Server already depends on the same runtime, so the
         Node a rendered view produces is the Node this template's hole accepts. -->
    <PackageReference Include="HtmlTypeProvider" Version="0.9.0" />
  </ItemGroup>
  <!-- The page template is read by the type provider at compile time, and MSBuild has
       no idea a .fs depends on an .html: editing the template alone leaves the
       provider's cached output in place and the old markup keeps being served, which
       looks exactly like a code change that did nothing. Touching the first file in the
       compile chain invalidates everything downstream and forces a re-read. Borrowed
       from BestFitBox's src/Web, where the same trap was found first. -->
  <ItemGroup>
    <TemplateFiles Include="page.html" />
  </ItemGroup>
  <Target Name="TouchOnTemplateChange" BeforeTargets="CoreCompile"
          Inputs="@(TemplateFiles)" Outputs="$(IntermediateOutputPath)template.stamp">
    <Touch Files="Program.fs" AlwaysCreate="false" />
    <Touch Files="$(IntermediateOutputPath)template.stamp" AlwaysCreate="true" />
  </Target>
</Project>

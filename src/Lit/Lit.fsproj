<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PackageId>Fable.Lit.Unofficial</PackageId>
    <Description>F# bindings for lit (lit-html and lit-element). Unofficial build of Fable.Lit, republished from a fork while fixes are pending upstream at github.com/fable-compiler/Fable.Lit.</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NpmDependencies>
      <NpmPackage Name="lit" Version="gte 3.0.0" ResolutionStrategy="Max" />
    </NpmDependencies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Parser.fs" />
    <Compile Include="Template.fs" />
    <Compile Include="Lit.fs" />
    <Compile Include="HMR.fs" />
    <Compile Include="Hook.fs" />
    <Compile Include="LitElement.fs" />
    <!-- Opt-in, and the only file that touches @lit-labs/ssr-client. -->
    <Compile Include="Hydrate.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="*.fsproj; *.fs; package.json" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.400" />
    <PackageReference Include="Fable.Core" Version="4.5.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
  </ItemGroup>
</Project>